<Project>

  <!--
    WJSS Stage 0.3A-1 product foundation - shared build properties.

    SOURCE-AUTHORED IN ARENA. NOT COMPILED IN ARENA (no .NET SDK available in the
    Arena sandbox; official SDK/NuGet endpoints are blocked there). The Owner-local
    Windows workstation build is the mandatory validation gate before merge:
    see docs/STAGE_0.3A_OWNER_LOCAL_VALIDATION.md.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <RollForward>LatestPatch</RollForward>

    <!--
      EnableWindowsTargeting allows the kiosk skeleton (net10.0-windows) to compile
      on a non-Windows build host in a future approved environment. It changes build
      metadata only; the kiosk remains compile-only in Stage 0.3A-1.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      NuGet lock files: generation is an OWNER-LOCAL step (see the validation
      document). No lock file is committed from Arena; none may be hand-authored.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      NU1900: the audit feed is unreachable in offline/locked restores; this
      warning must not break a build that is otherwise deterministic.
    -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

</Project>
