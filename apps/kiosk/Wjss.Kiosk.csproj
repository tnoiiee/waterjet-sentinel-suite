<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WJSS application-owned Windows shell.

    Stage 0.4C-K1 (Owner-authorized product preview development): this project is
    now the real shell, not a compile-only skeleton. It hosts the local
    Operations route in the fixed-name embedded web-view runtime control supplied
    by the Owner-approved package Microsoft.Web.WebView2 (pinned centrally in
    Directory.Packages.props; EVERGREEN runtime for this development preview).

    What the shell owns, and nothing else:
      starts nothing, commands nothing, parses no state, stores no credential;
      loads only the approved loopback origin, in this window, with no address
      bar, no tab strip, no developer tools and no external navigation;
      presents a local Runtime-unavailable / reconnecting state without showing
      stale values as current values;
      provides an intentional, confirmed operator exit path.

    The shell holds NO Production control authority, never talks to a device and
    never writes to one. No process supervision of the Runtime is implemented in
    this Stage: the Operator starts the local host, as the Stage runbook states.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA (no .NET SDK in the Arena
    sandbox). The Owner-local Windows build and run are the validation of record.
    The Kiosk lock file must be refreshed Owner-locally after the package
    reference below is added; see apps/kiosk/README.md.

    EnableWindowsTargeting=true is set solution-wide (Directory.Build.props) so a
    non-Windows .NET SDK can compile this Windows-targeted project.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Wjss.Kiosk</RootNamespace>
    <AssemblyName>Wjss.Kiosk</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 correction (Owner-local build 2026-10-07): DPI is configured
         through the WinForms project property, never the app.manifest. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version comes from the central pin in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>
