<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WJSS Runtime host: composition root for the Equipment Runtime and the
    integrated ASP.NET Core loopback API (ADR-0007; transport baseline SSE over
    HTTP + loopback origin chosen at the Stage 0.3A Owner gate).

    Stage 0.3A-1: health endpoints ONLY.
      GET /health/live  -> 200 while the host process is alive (not a claim
                           that the Product Runtime is implemented)
      GET /health/ready -> 503 + RUNTIME_NOT_IMPLEMENTED

    No Snapshot, Delta, SSE stream, commands, Runtime state or Simulator
    behaviour in this file (0.3A-2+ not authorized). Startup with any device
    profile other than SIMULATOR is refused BEFORE any port is bound.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA - Owner-local build and
    execution are the validation of record
    (docs/STAGE_0.3A_OWNER_LOCAL_VALIDATION.md).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wjss.Runtime</RootNamespace>
    <AssemblyName>Wjss.Runtime</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/contracts/Wjss.Contracts.csproj" />
    <ProjectReference Include="../../packages/domain/Wjss.Domain.csproj" />
    <ProjectReference Include="../../packages/application/Wjss.Runtime.Core.csproj" />
    <ProjectReference Include="../../packages/time/Wjss.Time.csproj" />
  </ItemGroup>

</Project>
