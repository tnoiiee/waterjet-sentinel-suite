<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    WJSS Runtime host: composition root for the Equipment Runtime and the
    integrated ASP.NET Core loopback API (ADR-0007; transport baseline SSE over
    HTTP + loopback origin chosen at the Stage 0.3A Owner gate).

    Stage 0.3A-2C: SIMULATOR runtime composition, deterministic synthetic
    evolution lifecycle and the READ-ONLY surface:
      GET /health/live    -> 200 while the host process is alive (not readiness)
      GET /health/ready   -> 200 only when every readiness condition holds, else
                             503 with a structured machine code
      GET /api/v1/snapshot -> current wjss.snapshot/1 projection
      GET /api/v1/runtime  -> read-only Runtime status
      GET /api/v1/deltas   -> bounded recent Delta activity
      GET /inspector       -> development-only Runtime Inspector page

    No write, command, dispatch or SSE surface exists. Startup with any device
    profile other than SIMULATOR is refused BEFORE any port is bound.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA - Owner-local build and
    execution are the validation of record
    (docs/STAGE_0.3A_OWNER_LOCAL_VALIDATION.md).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wjss.Runtime</RootNamespace>
    <AssemblyName>Wjss.Runtime</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ACCELERATED-CLEANING-INTEGRATION-01: ONE motion port implementation, shared by source link.

      The port must live in an assembly that can see both the internal motion-library controller
      owner and the Application IManualMotionPort contract. The adapter project deliberately has no
      Application/Contracts reference (its own documented boundary), and the Application project
      cannot see the adapter (that would be a cycle). Linking the single existing file is therefore
      the only way to reuse the shipped port instead of writing a second motion adapter.
    -->
    <Compile Include="../motion-commissioning/MotionLibraryManualMotionPort.cs" Link="Motion/MotionLibraryManualMotionPort.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The development Inspector page ships with the host output so the route can
      serve it from the build directory without a Node build pipeline.
    -->
    <Content Include="Inspector\index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/simulator/Wjss.Adapters.Simulator.csproj" />
    <ProjectReference Include="../../adapters/tc-acquisition/Wjss.Adapters.TcAcquisition.csproj" />
    <!-- ACCELERATED-CLEANING-INTEGRATION-01: the physical-capable motion boundary. The owner is
         internal to the adapter, exposed to this assembly via InternalsVisibleTo. -->
    <ProjectReference Include="../../adapters/motion-library/Wjss.Adapters.MotionLibrary.csproj" />
    <ProjectReference Include="../../packages/contracts/Wjss.Contracts.csproj" />
    <ProjectReference Include="../../packages/domain/Wjss.Domain.csproj" />
    <ProjectReference Include="../../packages/application/Wjss.Runtime.Core.csproj" />
    <ProjectReference Include="../../packages/time/Wjss.Time.csproj" />
  </ItemGroup>

</Project>
