<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Isolated Owner-invoked C1 Stop-only console harness for the later no-load WSB1 trial.

    This executable has exactly one invocation shape: the fixed no-load-stop-trial mode and one
    typed A or B selection. It accepts no command text, files, stdin, interactive input or native
    options. Owner-local consent, endpoint validation and Gate A native identity proof all precede
    the restricted native lifecycle. It performs no Runtime/API/Kiosk/Preview composition and does
    not open the application Motion gate. A separate post-merge Scope Gate is required before any
    physical trial.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA (.NET SDK unavailable in the Arena sandbox).
    The Owner-local run is the validation of record (docs/MOTION_STOP_TRIAL_RUNBOOK.md). The
    genuine packages.lock.json must be generated by Owner-local restore; never hand-author it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wjss.MotionStopTrial</RootNamespace>
    <AssemblyName>Wjss.MotionStopTrial</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/motion-library/Wjss.Adapters.MotionLibrary.csproj" />
  </ItemGroup>

</Project>
