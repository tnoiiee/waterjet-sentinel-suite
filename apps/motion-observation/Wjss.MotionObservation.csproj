<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WJSS one-shot read-only motion observation harness (B2-H executable composition).

    An Owner-invoked, console-only front-end for the Wjss.Adapters.MotionLibrary B2 observation
    trial. It takes no arguments, binds no port, opens no listener, writes no file and starts no
    Runtime: it resolves the Owner-local native-library values and the Owner-local controller
    address variable, runs the Gate A proof, selects the direct/no-gcaps posture, opens exactly one
    controller handle with the validated controller address, executes the fixed sixteen typed
    read-only intents ONCE in plan order, invalidates the observation boundary, closes the handle
    and releases the native modules, then prints a REDACTED JSON outcome.

    No raw controller command, no write, no output control, no configuration write, no motion and
    no discovery exist here or can be constructed from here. The Motion authorization gate stays
    CLOSED and physical execution is a separate Owner-local B2-H decision.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA (no .NET SDK available in the Arena sandbox).
    The Owner-local run is the validation of record
    (docs/MOTION_OBSERVATION_TRIAL_RUNBOOK.md). The genuine packages.lock.json of this project is
    produced only by the Owner-local restore, never hand-authored.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wjss.MotionObservation</RootNamespace>
    <AssemblyName>Wjss.MotionObservation</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/motion-library/Wjss.Adapters.MotionLibrary.csproj" />
  </ItemGroup>

</Project>
