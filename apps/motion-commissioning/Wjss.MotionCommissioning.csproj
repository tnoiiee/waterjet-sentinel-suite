<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WJSS Owner-local Manual Motion Commissioning application (WSB1 Axis A Horizontal / Axis B Vertical).

    An isolated Windows application. It composes the pure Application-owned Manual Motion session
    (packages/application, namespace Wjss.Runtime.Core.Motion.Manual) with either the deterministic
    SIMULATED port or the hardware-capable motion-library adapter path. It is not part of Runtime,
    API, Kiosk, Operations Preview, automatic sequence or Production composition, and nothing there
    references it. It carries no raw command entry: every control posts a typed Application request.

    Two invocation shapes only: `simulated` or `wsb1-hardware`. The hardware-capable mode needs the
    exact Owner-local consent, the Owner-local profile file, the existing endpoint and Gate A values,
    and a separate post-merge Owner Scope Gate before it is ever used against a real Controller.

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA (no .NET SDK in the Arena sandbox). The genuine
    packages.lock.json must be generated by Owner-local restore; never hand-author it.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Wjss.MotionCommissioning</RootNamespace>
    <AssemblyName>Wjss.MotionCommissioning</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/motion-library/Wjss.Adapters.MotionLibrary.csproj" />
    <ProjectReference Include="../../packages/application/Wjss.Runtime.Core.csproj" />
  </ItemGroup>

</Project>
