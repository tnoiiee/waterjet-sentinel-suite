<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WJSS domain tests (xUnit). Owner-local execution required; Arena does not
    run .NET tests (no SDK). SOURCE-AUTHORED IN ARENA.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wjss.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/domain/Wjss.Domain.csproj" />
    <ProjectReference Include="../../packages/contracts/Wjss.Contracts.csproj" />
  </ItemGroup>

</Project>
