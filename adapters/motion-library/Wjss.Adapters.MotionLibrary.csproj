<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WJSS motion library adapter — native load / version probe boundary (Native Load
    / Version Probe Software Gate).

    This project is the infrastructure side of separately authorized, vendor-neutral,
    fail-closed motion-library surfaces. Gate A proves the Owner-installed library from its
    approved Owner-local directory and resolves only the library-local version export. B1
    exposes the six typed identity exports. B2 observation is a separate fixed read-only
    boundary. PR #32 adds the C1 Stop-only typed A/B plan and owner; the isolated
    Wjss.MotionStopTrial executable is the only production composition that opens a handle
    for that Stop trial. The Stop path reuses only the approved direct/open/close lifecycle
    and fixed command export; it adds no raw-command, discovery, identity-read, or other
    motion entry point. PR #34 adds the closed typed Manual Motion Commissioning plan, its
    carrier and one long-lived WSB1 controller owner that reuses the same restricted
    lifecycle, the B2 read boundary and the typed A/B Stop session; the isolated
    Wjss.MotionCommissioning application is its only production composition.

    Boundary: self-owned (mirroring adapters/tc-acquisition); no Contracts/Domain
    reference and no package reference of any kind (operating-system loading primitives
    and BCL only); redacted outcomes only; owner-local configuration by environment
    variables only. No native binary, header, import library or vendor wrapper is part
    of this project, and none may ever be added (see .gitignore and the source-boundary
    tests).

    SOURCE-AUTHORED IN ARENA; NOT COMPILED IN ARENA (no .NET SDK available in the
    Arena sandbox; official SDK/NuGet endpoints are blocked there). The Owner-local
    Windows workstation build is the validation of record. The genuine
    packages.lock.json of this project is produced only by the Owner-local restore,
    never hand-authored (see docs/NATIVE_LOAD_VERSION_PROBE_RUNBOOK.md).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wjss.Adapters.MotionLibrary</RootNamespace>
    <AssemblyName>Wjss.Adapters.MotionLibrary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Focused-test seam: the kernel is internal so the complete native-load defect
         class (missing export, wrong module path, failed unload, dead buffer) is
         exercised without any real native module. -->
    <InternalsVisibleTo Include="Wjss.MotionLibrary.Tests" />
    <InternalsVisibleTo Include="Wjss.MotionStopTrial" />
    <!-- PR #34: the isolated Owner-local Manual Motion Commissioning application (WSB1 A/B). It
         composes the internal controller owner, the closed commissioning plan and the existing
         typed Stop session; it is not Runtime/API/Kiosk/Preview/Production composition. -->
    <InternalsVisibleTo Include="Wjss.MotionCommissioning" />
  </ItemGroup>

</Project>
